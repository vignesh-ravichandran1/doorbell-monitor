# Settings for THIS computer. `npm run setup` creates .env from this file and fills it in;
# you can also edit .env by hand. .env is never committed to git.

# Leave empty: `npm run setup` saves the Ring login in .ring-token on this computer.
# Every computer needs its OWN login. Copying it between computers breaks it, because
# Ring replaces it regularly and the old copy stops working.
RING_REFRESH_TOKEN=

# Where clips go. Default: the "recordings" folder inside this app.
#   Windows external disk:  RECORDINGS_PATH=E:/doorbell
#   Mac external disk:      RECORDINGS_PATH=/Volumes/MyDisk/doorbell
#   Linux external disk:    RECORDINGS_PATH=/mnt/doorbell
RECORDINGS_PATH=recordings

# Purging, checked after every clip and hourly. Oldest clips go first.
KEEP_DAYS=14          # delete clips older than this many days
MAX_STORAGE_GB=20     # keep all clips together under this size (0 = no cap)
MIN_FREE_GB=5         # also purge if the disk itself gets this low

RECORD_SECONDS=30
RECORD_ON=ding,motion # which events record a clip

# Clips page: http://<this computer's IP>:8080
WEB_PORT=8080

# Optional phone alerts via the free ntfy app. Off when NOTIFY_ON is empty
# (the Ring app already alerts you). The topic acts as a password: make it long and random.
NOTIFY_ON=
NTFY_TOPIC=
NTFY_URL=https://ntfy.sh
NTFY_TOKEN=
MOTION_COOLDOWN_SECONDS=120
WEB_BASE_URL=         # e.g. http://192.168.2.50:8080, so tapping an alert opens the clip
