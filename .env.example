# Copy to .env (scripts/configure.sh does this for you and fills in the secrets).

# Where clips go. Point this at the external hard disk mount.
RECORDINGS_PATH=/mnt/doorbell

# Must match livestream_user / livestream_pass in ring-mqtt/config.json.
LIVESTREAM_USER=doorbell
LIVESTREAM_PASS=change-me

# Phone notifications via the free ntfy app (Android / iPhone).
# The topic name works like a password: anyone who knows it can read your alerts.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=change-me
NTFY_TOKEN=

# Tapping a notification opens the clip. Use the laptop's IP on your home network.
WEB_BASE_URL=http://192.168.2.50:8080

CAMERA_NAME=Front door
RECORD_SECONDS=30
# Which events record a clip / notify the phone: ding, motion
RECORD_ON=ding,motion
NOTIFY_ON=ding,motion
# Don't buzz the phone for motion more than once per this many seconds.
MOTION_COOLDOWN_SECONDS=120

# Delete clips older than this, and the oldest clips whenever free space drops below MIN_FREE_GB.
KEEP_DAYS=30
MIN_FREE_GB=10
